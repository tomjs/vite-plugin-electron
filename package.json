{
  "name": "@tomjs/vite-plugin-electron",
  "type": "module",
  "version": "2.5.1",
  "packageManager": "pnpm@10.34.5",
  "description": "A simple vite plugin for electron, supports esm/cjs, support esm in electron v28+",
  "author": {
    "name": "Tom Gao",
    "email": "tom@tomgao.cc"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomjs/vite-plugin-electron.git"
  },
  "keywords": [
    "vite",
    "plugin",
    "electron",
    "tsup",
    "esm",
    "cjs"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./electron": "./dist/electron.mjs",
    "./env": "./env.d.ts"
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "env.d.ts"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "run-s lint:stylelint lint:eslint",
    "lint:stylelint": "stylelint \"examples/**/*.{css,scss,less,vue,html}\" --fix --cache",
    "lint:eslint": "eslint --fix",
    "prepare": "simple-git-hooks",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "electron": ">=12.0.0",
    "electron-builder": ">=24.2.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "electron-builder": {
      "optional": true
    }
  },
  "dependencies": {
    "execa": "^9.6.1",
    "lodash.clonedeep": "^4.5.0",
    "lodash.merge": "^4.6.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@commitlint/cli": "^21.2.2",
    "@tomjs/commitlint-config": "^1.1.1",
    "@tomjs/eslint-config": "^1.1.1",
    "@tomjs/stylelint-config": "^1.0.0",
    "@tomjs/tsconfig": "^4.0.0",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^22.20.1",
    "electron": "^44.0.0",
    "eslint": "^10.9.1",
    "lint-staged": "^16.2.7",
    "npm-run-all": "^4.1.5",
    "publint": "^0.3.24",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.13.1",
    "stylelint": "^17.14.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "vite": "^8.2.2"
  }
}
